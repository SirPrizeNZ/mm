{
  "name": "scale-miniatures",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "type": "module",
  "description": "Micro Machines (PC, 1994) rewritten in TypeScript from the disassembly, running natively in the browser. No emulator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "poll": "node server/poll.mjs",
    "relay": "node server/relay.mjs",
    "build:figjam": "tsc -p figjam/tsconfig.json && node figjam/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.engine.json --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "@figma/widget-typings": "^1.13.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
